# Optional local test config only. Copy to .env.test, supply disposable credentials/keys.
# Offline unit tests use temporary synthetic settings and do not load this file.
# Never use real QQ/QWeather credentials or the production database with this file.
QQ_APP_ID=
QQ_CLIENT_SECRET=
QWEATHER_API_HOST=https://your-test-account.qweatherapi.com
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
QWEATHER_PRIVATE_KEY_FILE=secrets/test-only-private.pem
BOT_DATABASE=data/test/bot.sqlite3
QWEATHER_MONTHLY_REQUEST_LIMIT=0
QWEATHER_USAGE_TIMEZONE=Asia/Shanghai
QQ_REPLY_FORMAT=text
BOT_COMMAND_PREFIX=
BOT_LOG_LEVEL=INFO
