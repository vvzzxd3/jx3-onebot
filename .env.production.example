# Copy to .env.production and fill locally. Never commit secrets or run this config in offline tests.
QQ_APP_ID=
QQ_CLIENT_SECRET=
QWEATHER_API_HOST=https://your-account.qweatherapi.com

# JWT only: all four settings are required; generate new Ed25519 keys outside version control.
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
QWEATHER_PRIVATE_KEY_FILE=secrets/qweather-private.pem

BOT_DATABASE=data/bot.sqlite3
# Supported group and private chat is archived by default and not automatically expired.
# Manual chat-forget is logical deletion, not secure erasure of WAL files or backups.
BOT_CHAT_MAX_TEXT_CHARS=16384
QWEATHER_MONTHLY_REQUEST_LIMIT=50000
QWEATHER_USAGE_TIMEZONE=Asia/Shanghai
QWEATHER_FORECAST_DAYS=3
QWEATHER_CACHE_SECONDS=3600
QWEATHER_MAX_RETRIES=1
BOT_WORKERS=2
# Optional exact command prefix; empty means "天气" and "天气 北京" without a slash.
BOT_COMMAND_PREFIX=
QQ_HEARTBEAT_ACK_INTERVALS=2
QQ_REPLY_FORMAT=text

# All log modes are unredacted and untruncated at the logging layer; safe only escapes one line.
# summary and HTTP logs still select fields; payload adds complete raw QQ WS text.
# Credentials, URLs and private content may leak: govern console collection, access and retention.
# Upstream database/business redaction and bounds remain independent; lost source data cannot be restored.
BOT_LOG_LEVEL=INFO
BOT_QQ_RECEIVE_LOG=summary
BOT_QQ_CHAT_LOG=true
BOT_QQ_LOG_MESSAGE_TEXT=true
